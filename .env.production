# Public client-side IDs: safe to commit, they appear in every page's HTML.
# A value set in Vercel -> Project -> Settings -> Environment Variables
# takes precedence over this file.

# Google Tag Manager container "bybo.in". GA4 (G-RVCB9JCE0W) and the Google
# Ads conversion (AW-11448518033) are configured inside it, so do not also set
# NEXT_PUBLIC_GA_MEASUREMENT_ID here, or GA4 will count every page view twice.
NEXT_PUBLIC_GTM_ID=GTM-KKZRCH46

# Meta Pixel "BYBO Pixel". Loaded directly by the site, not through GTM, so it
# must not also be added as a tag in the GTM container or events will double.
NEXT_PUBLIC_META_PIXEL_ID=777753857519886
