# Copy to `.env.local` for local dev, or add in Vercel → Project → Settings → Environment Variables.

# --- Marketing pixels (client-side; use NEXT_PUBLIC_ prefix) ---

# Meta (Facebook) Pixel ID — from Meta Events Manager → Data sources → your pixel
# Example: 1234567890123456
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement ID — from GA4 Admin → Data streams
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID — optional; use GTM OR direct GA4, not both unless intentional
# Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- SEO verification (server-side only; no NEXT_PUBLIC_ prefix) ---

# Google Search Console — HTML tag method (content value only, not the full meta tag)
# Example: abc123XYZ...
GOOGLE_SITE_VERIFICATION=
