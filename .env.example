# Copy to `.env.local` for local dev, or add in Vercel → Project → Settings → Environment Variables.

# --- Marketing pixels (client-side; use NEXT_PUBLIC_ prefix) ---

# Meta (Facebook) Pixel ID — from Meta Events Manager → Data sources → your pixel
# Example: 1234567890123456
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement ID — from GA4 Admin → Data streams
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID — optional; use GTM OR direct GA4, not both unless intentional
# Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- SEO verification (server-side only; no NEXT_PUBLIC_ prefix) ---

# Google Search Console — HTML tag method (content value only, not the full meta tag)
# Example: abc123XYZ...
GOOGLE_SITE_VERIFICATION=

# --- Enquiry form delivery (server-side only, never NEXT_PUBLIC_) ---

# REQUIRED. Resend API key, from resend.com -> API Keys.
# Without it /api/enquiry returns 503 "not_configured" and the form falls back
# to the visitor's own email client — which is the bug this replaced.
RESEND_API_KEY=

# Optional. Where enquiries are delivered. Defaults to CONTACT.email in
# src/lib/site.ts (support@bybo.in).
ENQUIRY_TO=

# Optional. The From address. MUST be on a domain verified in Resend or every
# send is rejected. Defaults to "BYBO <support@bybo.in>".
ENQUIRY_FROM=

# Optional. Set to 1 to also send the visitor an acknowledgement.
# Left off by default: it would arrive from support@bybo.in, which has no MX
# record yet, so anyone replying to it would bounce. Turn on once receiving
# for support@ is set up.
ENQUIRY_ACK=
