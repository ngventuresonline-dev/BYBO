# Copy to `.env.local` for local dev, or add in Vercel → Project → Settings → Environment Variables.

# --- Marketing pixels (client-side; use NEXT_PUBLIC_ prefix) ---

# Meta (Facebook) Pixel ID — from Meta Events Manager → Data sources → your pixel
# Example: 1234567890123456
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4 measurement ID — from GA4 Admin → Data streams
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager container ID — optional; use GTM OR direct GA4, not both unless intentional
# Example: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# --- SEO verification (server-side only; no NEXT_PUBLIC_ prefix) ---

# Google Search Console — HTML tag method (content value only, not the full meta tag)
# Example: abc123XYZ...
GOOGLE_SITE_VERIFICATION=

# --- Enquiry form delivery (server-side only, never NEXT_PUBLIC_) ---

# REQUIRED. Resend API key, from resend.com -> API Keys.
# Without it /api/enquiry returns 503 "not_configured" and the form falls back
# to the visitor's own email client — which is the bug this replaced.
RESEND_API_KEY=

# Optional. Extra team inboxes, comma-separated. The route ALWAYS delivers
# to support@bybo.in and byboonline@gmail.com; this cannot drop either one.
# If you set it in Vercel, include both so the env matches what actually
# happens:
#   ENQUIRY_TO=support@bybo.in,byboonline@gmail.com
ENQUIRY_TO=

# Optional. The From address. MUST be on a domain verified in Resend or every
# send is rejected. Defaults to "BYBO <support@bybo.in>".
ENQUIRY_FROM=

# After the team email succeeds, /api/enquiry also sends the visitor the
# published Resend template `bybo-enquiry-ack`. A failed acknowledgement is
# logged and does not fail the enquiry.

# --- Instant call (server-side only, never NEXT_PUBLIC_) ---
# The whole call path is impossible unless INSTANT_CALL_ENABLED is the string true.
# It is off when this variable is missing. Do not set it until the allowlist,
# the Blob store, and BYBO_ELEVENLABS_API_KEY are in place.

# Master switch. Only the exact string true turns calling on.
INSTANT_CALL_ENABLED=false

# When true, the lead is stored and the log says "would dial". ElevenLabs is not called.
INSTANT_CALL_DRY_RUN=

# Comma-separated E.164 numbers.
# Unset: only +919686613899 can be dialled.
# Exactly * (after trimming): any number normalizePhone accepts. Consent, the
# switch, dry-run, calling hours and the one-claim-per-day lock still apply.
# Empty, or any token that is not a phone: nobody is dialled (no fallback).
# A * beside other tokens is a bad token, not open mode.
INSTANT_CALL_ALLOWLIST=+919686613899

# Asia/Kolkata, Monday–Saturday. Invalid values fall back to these defaults.
CALL_HOURS_START=10:00
CALL_HOURS_END=19:30

# Already set on Vercel for Production and Preview. The code reads these names,
# not ELEVENLABS_AGENT_ID / ELEVENLABS_PHONE_NUMBER_ID.
BYBO_ELEVENLABS_API_KEY=
BYBO_ELEVENLABS_AGENT_ID=
BYBO_ELEVENLABS_PHONE_NUMBER_ID=

# HMAC secret for POST /api/elevenlabs/post-call (header ElevenLabs-Signature).
ELEVENLABS_WEBHOOK_SECRET=

# Bearer token for /api/cron/instant-call and /api/admin/meta-leads.
CRON_SECRET=

# Meta lead ads webhook (/api/meta/leadgen) and Graph lead fetch.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
# Optional. Defaults to v21.0.
META_GRAPH_VERSION=

# Shared secret for /api/voice/slots and /api/voice/book (header x-bybo-voice-secret).
# Those routes also stay dark until INSTANT_CALL_ENABLED=true.
VOICE_TOOL_SECRET=

# Private Vercel Blob store linked to this project. Create it in the dashboard
# or with `vercel blob create-store bybo-leads --access private` and connect it.
# The token is injected by Vercel. Do not commit it. Without it, leads are not
# stored and nobody is dialled.
BLOB_READ_WRITE_TOKEN=
